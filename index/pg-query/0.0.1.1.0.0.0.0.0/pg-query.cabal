cabal-version:      2.2
name:               pg-query
version:            0.0.1.1.0.0.0.0.0
license:            BSD-3-Clause
license-file:       LICENSE
maintainer:         rhzmc@proton.me
author:             rhizomic
homepage:           https://git.sr.ht/~rhizomic/pg-query
synopsis:
    Parse PostgreSQL DDL and DML: Haskell bindings for libpg_query

description:
    pg-query offers Haskell bindings for @<https://github.com/pganalyze/libpg_query libpg_query>@, which makes use of the actual PostgreSQL server source to parse SQL queries and return the internal PostgreSQL parse tree.

category:           Database, Data
build-type:         Simple
extra-source-files:
    README.md
    CHANGELOG.md
    PgQuery.proto

library
    exposed-modules:
        PgQuery
        PgQuery.Internal.Parse
        PgQuery.Internal.Proto.PgQuery
        PgQuery.Internal.Proto.PgQuery_Fields

    c-sources:          helpers/pg_query_helper.c
    hs-source-dirs:     src
    default-language:   Haskell2010
    default-extensions: StrictData
    extra-libraries:    pg_query
    build-depends:
        base >=4.0 && <5.0,
        bytestring >=0.11 && <1.0,
        proto-lens >=0.7.1.5 && <1.0,
        proto-lens-runtime >=0.7.0.6 && <1.0,
        text >=2.0 && <3.0

test-suite pg-query-test
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    build-tool-depends: hspec-discover:hspec-discover
    hs-source-dirs:     test
    other-modules:
        PgQuery.DeparseSpec
        PgQuery.ParamsSpec
        PgQuery.PlpgsqlSpec
        PgQuery.TriggerSpec
        Paths_pg_query

    autogen-modules:    Paths_pg_query
    default-language:   Haskell2010
    ghc-options:        -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >=4.0 && <5.0,
        bytestring >=0.11 && <1.0,
        hspec,
        hspec-contrib,
        hspec-expectations-pretty-diff,
        lens,
        pg-query,
        proto-lens >=0.7.1.5 && <1.0,
        proto-lens-runtime >=0.7.0.6 && <1.0,
        text >=2.0 && <3.0

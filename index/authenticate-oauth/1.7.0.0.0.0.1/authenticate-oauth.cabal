cabal-version:      >=1.10
name:               authenticate-oauth
version:            1.7.0.0.0.0.1
license:            BSD3
license-file:       LICENSE
maintainer:         Hiromi Ishii, Artem Chirkin
author:             Hiromi Ishii
stability:          Stable
homepage:           http://github.com/yesodweb/authenticate
synopsis:
    Library to authenticate with OAuth for Haskell web applications.

description:
    API docs and the README are available at <http://www.stackage.org/package/authenticate-oauth>.

category:           Web
build-type:         Simple
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
    type:     git
    location: https://github.com/yesodweb/authenticate.git

flag use-crypton-pubkey-types
    description:
        Use the package crypton-pubkey-types the fork of crypto-pubkey-types

library
    exposed-modules:
        Web.Authenticate.OAuth
        Web.Authenticate.OAuth.IO

    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.10 && <5,
        http-client >=0.3,
        transformers >=0.1 && <0.7,
        bytestring >=0.9,
        RSA >=2.0 && <2.5,
        time,
        data-default,
        base64-bytestring >=0.1 && <1.3,
        SHA >=1.4 && <1.7,
        random,
        http-types >=0.6,
        blaze-builder,
        transformers-compat >=0.3

    if flag(use-crypton-pubkey-types)
        build-depends: crypton-pubkey-types >=0.5 && <0.6

    else
        build-depends: crypto-pubkey-types >=0.2 && <0.5
